#!/usr/bin/env bash
# cúramóir precompact hook. Wrapper exists because an installed plugin is an unpacked
# directory, not a pip install, so `curamoir` is not on the import path.
# Must never fail noisily: hooks fail open, so a crash protects nothing.
set -u

root="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

# Interpreter selection, the flags and the bootstrap live in one file all
# seven launchers source, src/curamoir/launcher.sh (cm-6f0): see it for why every launch is `-P -E`.
# With no interpreter that qualifies, or no such file, exit 0: no decision,
# and the normal flow applies. Never noisily: hooks fail open.
. "${root}/src/curamoir/launcher.sh" 2>/dev/null || exit 0
curamoir_choose_python || exit 0
curamoir_exec_module "${root}/src" curamoir.hooks.precompact

