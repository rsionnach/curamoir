#!/usr/bin/env bash
# cúramóir CLI wrapper.
#
# Exists for the same reason the hook wrapper does: an installed plugin is an
# unpacked directory, not a pip install, so `curamoir` is not on the import path.
set -euo pipefail

# The root is this script's own location, never CLAUDE_PLUGIN_ROOT (cm-6f0): a
# relative value is read against the working directory, the open repository,
# and an inherited one names some other copy of the code. Claude Code runs
# this file by its path under the plugin root, so the two agree.
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Interpreter selection, the flags and the bootstrap live in one file all
# seven launchers source, src/curamoir/launcher.sh (cm-6f0): see it for why every launch is `-P -E`, and
# so why PYTHONPATH is not honoured. The CLI prefers an interpreter that can
# import PyYAML (cm-kry): every command that reads curamoir.yaml needs it, and
# the fallback still runs, so the CLI (and /curamoir:doctor) can say what is
# missing.
. "${root}/src/curamoir/launcher.sh" || {
  echo "cúramóir: cannot load ${root}/src/curamoir/launcher.sh" >&2
  exit 1
}
if ! curamoir_choose_python prefer-yaml; then
  echo "cúramóir $(curamoir_no_python_message)" >&2
  exit 1
fi

curamoir_exec_module "${root}/src" curamoir.cli "$@"
