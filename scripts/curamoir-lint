#!/usr/bin/env bash
# curamoir-lint: run .curamoir/rules/*.yaml against a repository (E2-R4).
#
# Standalone by design (E2-R5): no model, no network, and no cúramóir install.
# It needs only this file, the `src/` directory beside it, a Python 3 with
# PyYAML, and — for ast-grep rules — the `ast-grep` binary. So CI can
# `git clone` cúramóir and call this script, and a pre-commit `local` hook can
# point at it, without the plugin being installed anywhere.
#
# Exit codes are the contract: 0 clean, 1 violations at or above the threshold,
# 2 the run cannot be trusted (see src/curamoir/lint.py). That includes this
# wrapper finding no Python: a gate that exits 0 because it could not start
# waves every commit through.
#
# Unlike the hook wrappers, CLAUDE_PLUGIN_ROOT is deliberately NOT consulted. A
# lint gate runs outside Claude Code, and inheriting a stale plugin root from a
# developer's shell would lint with a different copy of the code than the one
# that was invoked. The script's own location is the only answer.
set -uo pipefail

# Parameter expansion rather than `dirname`, so locating src/ does not depend
# on PATH (a pre-commit or CI environment can be very sparse). When invoked
# through a symlink (how a checkout is usually put on PATH), the link is
# followed to the real script first, since src/ is beside that, not the link.
# `readlink` without `-f`, one hop at a time, because macOS's bash 3.2 era
# userland has no `readlink -f`; it is the one external command this needs,
# and only when there is a symlink. The hop limit stops a symlink loop.
source="${BASH_SOURCE[0]}"
hops=0
while [ -L "$source" ]; do
  hops=$((hops + 1))
  link="$(readlink "$source")" && [ "$hops" -le 40 ] || {
    echo "curamoir-lint: cannot resolve the symlink $source to its own directory" >&2
    exit 2
  }
  case "$link" in
    /*) source="$link" ;;
    *)
      case "$source" in
        */*) source="${source%/*}/$link" ;;
        *) source="$link" ;;
      esac
      ;;
  esac
done
case "$source" in
  */*) here="${source%/*}" ;;
  *) here="." ;;
esac
# `-P`, so `..` is the parent of the directory the script really is in: when
# `scripts/` itself is a symlink (the script inside it is not), the logical
# `..` would be the link's parent, which has no `src/`.
root="$(cd -P "$here/.." && pwd -P)" || { echo "curamoir-lint: cannot locate its own directory" >&2; exit 2; }

# Python must never import from the repository being linted: pre-commit and
# CI run this from the linted repo's root, so a `yaml.py`, `json.py` or
# `curamoir/` committed in an unreviewed PR would be imported, and executed,
# as the linter (and a hostile one exiting 1 reads as "violations"). Every
# launch, the PyYAML probe included, is `-P -E` with our own src/ inserted by
# a bootstrap: src/curamoir/launcher.sh says why, and why PYTHONPATH is
# therefore not honoured. The working directory is still recorded and the
# run starts in src/; lint.py moves back to the recorded directory after its
# imports, so `--repo` (default `.`, or a relative path) means exactly what it
# meant to the person who typed it.
invoked_from="$PWD"
cd "$root/src" || { echo "curamoir-lint: cannot enter $root/src" >&2; exit 2; }

# The same candidates and the same order as every other launcher, preferring
# one that can import PyYAML (rule files are YAML), and falling back to the
# first that qualifies. An interpreter below the floor no longer qualifies,
# so the old 3.9 fallback is gone (cm-6f0): without -P it could not run
# safely here.
# Guarded: a source of a missing file that went on would end in exit 1, which
# this script's contract reads as violations.
. "$root/src/curamoir/launcher.sh" || {
  echo "curamoir-lint: cannot load $root/src/curamoir/launcher.sh. Nothing was checked." >&2
  exit 2
}
if ! curamoir_choose_python prefer-yaml; then
  echo "curamoir-lint: $(curamoir_no_python_message) Nothing was checked." >&2
  exit 2
fi

export CURAMOIR_LINT_INVOKED_FROM="$invoked_from"
curamoir_exec_module "${root}/src" curamoir.lint "$@"
