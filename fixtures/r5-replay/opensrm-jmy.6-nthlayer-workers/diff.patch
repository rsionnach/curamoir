+        import subprocess
+
+        result = subprocess.CompletedProcess(
+            args=["gh", "pr", "create"],
+            returncode=0,
+            stdout="https://github.com/org/repo/pull/99\n",
+            stderr="",
+        )
+        captured = {}
+
+        def fake_run(args, **kw):
