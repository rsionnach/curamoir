new file mode 100644
index 0000000..4a515a6
--- /dev/null
+++ b/spec/v2/examples/judgment-thresholds/ai-gate-template.yaml
@@ -0,0 +1,20 @@
+# OpenSRM v2 ServiceManifestTemplate carrying judgment thresholds.
+#
+# A template MAY carry `judgment_threshold`; its items are the same
+# JudgmentThresholdSpec a ServiceManifest uses (decision 3c,
+# opensrm-l33e). Nothing in the fixture set extends this template: it
+# exists to keep the template side of the rule exercised.
+apiVersion: opensrm.nthlayer.io/v2
+kind: ServiceManifestTemplate
+metadata:
+  name: decision-services-thresholds-base
+  namespace: default
+spec:
+  judgment_threshold:
+    # Stability bound shared by every decision service built on this base.
+    - type: stability
+      probe:
+        frozen_input_set: "s3://probes/credit-decision-2026q1.jsonl"
+        frequency: daily
+      bounds:
+        maximum_drift: 0.02
diff --git a/spec/v2/examples/judgment-thresholds/all-five-types.yaml b/spec/v2/examples/judgment-thresholds/all-five-types.yaml
new file mode 100644
index 0000000..13cf7ce
--- /dev/null
+++ b/spec/v2/examples/judgment-thresholds/all-five-types.yaml
@@ -0,0 +1,40 @@
+# Judgment thresholds — one of each of the five types (decision 3c).
+# Bounds on error magnitudes: breach when the measured value EXCEEDS the bound.
+# No error budget and no complement, unlike judgment_slo.
+apiVersion: opensrm.nthlayer.io/v2
+kind: ServiceManifest
+metadata:
+  name: credit-decision-agent
+  labels:
+    tier: critical   # optional in the schema; nthlayer-common still requires it (opensrm-9bil)
+spec:
+  owner:
+    group: group:default/risk
+  service:
+    name: credit-decision-agent
+    type: ai-gate
+  judgment_threshold:
+    - type: segments
+      segment_dimension: customer_tier
+      segment_values: [enterprise, smb, consumer]
+      bounds:
+        maximum_variance_from_overall: 0.05
+    - type: stability
+      probe:
+        frozen_input_set: "s3://probes/credit-decision-2026q1.jsonl"
+        frequency: daily
+      bounds:
+        maximum_drift: 0.02
+    - type: calibration
+      measurement:
+        bins: 10
+        window: 30d
+      bounds:
+        maximum_brier_score: 0.05
+    - type: audit_backlog
+      bounds:
+        maximum_age: 24h
+    - type: feedback_latency
+      bounds:
+        maximum_p50: 1h
+        maximum_p90: 24h
