+_SEG_BOUNDS = {"maximum_variance_from_overall": 0.05}
+
+
+@pytest.mark.parametrize(
+    ("threshold_type", "bounds", "fields", "match"),
+    [
+        ("segments", _SEG_BOUNDS,
