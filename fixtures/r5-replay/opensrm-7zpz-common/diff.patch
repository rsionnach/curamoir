+    pairing = {}
+    for rule in rules:
+        metric = rule["if"]["properties"]["metric"]["const"]
+        then = rule["then"]
+        if "outcome_signal" in then.get("required", []):
+            pairing[metric] = "outcome_signal"
+        else:
+            [param] = then["properties"]["measurement"]["required"]
