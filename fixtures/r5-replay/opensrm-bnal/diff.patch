+mkdir -p "$DIST"
+make_sibling "$DIST/nthlayer-common" nthlayer-common 2.1.2
+make_sibling "$DIST/nthlayer-common-rival" nthlayer-common 3.5.0
+make_consumer "$DIST/nthlayer-core" nthlayer-core ">=2.1.2,<3.0.0" 2.1.2
