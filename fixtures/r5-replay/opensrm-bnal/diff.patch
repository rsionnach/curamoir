+
+# --- Test 20: the worktree fix must hold on git < 2.31 ---------------------
+
+echo
+echo "=== Test 20: identity survives a git that does not know --path-format ==="
+# opensrm-bnal, round-1 CRITICAL. Reinstating `--path-format=absolute` in
