+        f"service:\n  name: svc\n  team: t\n  tier: critical\n  type: api\n  template: {template}\n"
+    )
+    result = _validate(path)
+    assert result.valid is valid, result.errors
+    if not valid:
+        assert len(result.errors) == 1, result.errors
