+# --- Test 35: a worktree is not a second declarer ---------------------------
+
+echo
+echo "=== Test 35: a worktree of the declaring repo is not a DUPLICATE-SCRIPT ==="
+# A worktree carries its parent's pyproject, scripts included, and CLAUDE.md
