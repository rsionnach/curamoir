+        "NULL",
+        "~",
+        "yes",
+        "Yes",
+        "no",
+        "on",
+        "off",
+        "true",
+        "false",
+        "123",
+        "1_000",
+        "1.5",
+        "0x1f",
+        "0b101",
+        "2026-01-01",
+        "ops ",
