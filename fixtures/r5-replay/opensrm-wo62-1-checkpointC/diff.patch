+#                 so 2.
+# Matches the Checkpoint B goldens cli_alerts_test uat__payment-api (1) and
+# opensrm__api-critical.reliability (2).
+ALERTS_TEST_EXIT = {"srm-valid": 1, "legacy-valid": 1, "srm-missing": 2}
