-    """
-    Check if data is in OpenSRM format.
-
-    OpenSRM format is identified by:
-    - apiVersion: srm/v1
-    - kind: ServiceReliabilityManifest
-    """
-    return data.get("apiVersion") == "srm/v1" and data.get("kind") == "ServiceReliabilityManifest"
