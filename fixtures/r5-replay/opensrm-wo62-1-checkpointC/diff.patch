+def _strip(value: Any, key: str) -> Any:
+    if isinstance(value, dict):
+        return {k: _strip(v, key) for k, v in value.items() if k != key}
+    if isinstance(value, list):
+        return [_strip(v, key) for v in value]
+    return value
+
