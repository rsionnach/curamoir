+++ b/tests/golden/test_golden_cli.py
@@ -0,0 +1,235 @@
+"""CLI cells: the manifest-path commands over the corpus (spec §6.2).
+
+Each cell drives a command's Python entry point (``*_command(...)``) and
+pins what is observable without reading console text: exit codes, files the
+command wrote (read back as structure where they are JSON or YAML), and
+JSON a command printed to stdout (captured and parsed). Console tables and
+messages are never asserted on.
+
+The manifests are the same loadable set as ``test_golden_generators``
+(``CASES``), so a manifest that starts or stops loading moves in or out of
+these cells in step. A command that raises has that pinned as
+``{"error": [type, message]}``, as in the generator cells.
+
+``topology`` has no provider in a test (it needs a Prometheus URL), so it
+exits 2 after the manifest load step; what is pinned is that exit code, and
+that a manifest which no longer loads changes it.
+"""
+
+from __future__ import annotations
+
+import json
+from collections.abc import Callable
+from pathlib import Path
+from typing import Any
+
+import pytest
+import yaml
+
+from nthlayer_generate.cli.alerts import (
+    alerts_evaluate_command,
+    alerts_show_command,
+    alerts_test_command,
+)
+from nthlayer_generate.cli.backstage import generate_backstage_command
+from nthlayer_generate.cli.docs import generate_docs_command
+from nthlayer_generate.cli.migrate import migrate_command
+from nthlayer_generate.cli.simulate import simulate_command
+from nthlayer_generate.cli.topology import topology_export_command
+from nthlayer_generate.cli.validate import validate_command
+from nthlayer_generate.dependencies import DependencyDiscovery
+from nthlayer_generate.orchestration.handlers import PolicyHandler
+from nthlayer_generate.orchestration.registry import OrchestratorContext
+from nthlayer_generate.policies.engine import PolicyEngine
+from nthlayer_generate.policies.models import PolicyReport
+
+from ._corpus import EX, _error, _graph_from_declared_dependencies, _load
+from ._golden import check
+from .test_golden_generators import CASES, IDS
+
+POLICIES = EX / "policies.yaml"
+
+
+class Env:
+    """What a cell may use: the temp dir and captured stdout."""
+
+    def __init__(
+        self,
+        tmp: Path,
+        capsys: pytest.CaptureFixture[str],
+        monkeypatch: pytest.MonkeyPatch,
+    ) -> None:
+        self.tmp = tmp
+        self.capsys = capsys
+        self.monkeypatch = monkeypatch
+
+    def stdout_json(self) -> Any:
+        """The JSON a command printed to stdout since the last call.
+
+        Raises if stdout is not exactly one JSON document, so noise can never
+        be pinned as a value.
+        """
+        return json.loads(self.capsys.readouterr().out)
+
+    def discard_output(self) -> None:
+        self.capsys.readouterr()
+
+    def files(self, root: Path | None = None) -> dict[str, Any]:
+        """Every file under ``root`` (default tmp), JSON/YAML parsed, else text."""
+        root = root or self.tmp
+        out: dict[str, Any] = {}
+        for p in sorted(root.rglob("*")):
+            if not p.is_file():
+                continue
+            text = p.read_text(encoding="utf-8")
+            rel = p.relative_to(root).as_posix()
+            if p.suffix == ".json":
+                out[rel] = json.loads(text)
+            else:
+                out[rel] = text
+        return out
+
+
+# --- cells: (manifest path, env) -> golden value -----------------------------
+
+
+def migrate(path: Path, env: Env) -> Any:
+    out = env.tmp / "out"
+    code = migrate_command(str(path), output_dir=str(out))
+    # srm/v1 manifests are already migrated: exit 0 and nothing written.
+    return {"exit": code, "files": env.files(out) if out.is_dir() else {}}
+
+
+def validate(path: Path, env: Env) -> Any:
+    return {
+        "default": validate_command(str(path)),
+        "strict": validate_command(str(path), strict=True),
+        "policies": validate_command(str(path), policies=str(POLICIES)),
+    }
+
+
+def alerts_evaluate(path: Path, env: Env) -> Any:
+    # no_notify is a no-op today: AlertPipeline hard-codes notify=False
+    # (slos/pipeline.py:94). It is passed anyway so a notifier can never be hit.
+    table = alerts_evaluate_command(str(path), no_notify=True)
+    env.discard_output()  # drop the table so stdout holds only the JSON below
+    as_json = alerts_evaluate_command(str(path), no_notify=True, output_format="json")
+    return {"table_exit": table, "json_exit": as_json, "json": env.stdout_json()}
+
+
+def alerts_show(path: Path, env: Env) -> Any:
+    table = alerts_show_command(str(path))
+    env.discard_output()
+    as_json = alerts_show_command(str(path), output_format="json")
+    return {"table_exit": table, "json_exit": as_json, "json": env.stdout_json()}
+
+
+def alerts_test(path: Path, env: Env) -> Any:
+    return {"exit": alerts_test_command(str(path), no_notify=True)}
+
+
+def docs(path: Path, env: Env) -> Any:
+    out = env.tmp / "out"
+    code = generate_docs_command(str(path), output=str(out), include_adr=True, include_api=True)
+    return {"exit": code, "files": env.files(out) if out.is_dir() else {}}
+
+
+def backstage(path: Path, env: Env) -> Any:
+    out = env.tmp / "out"
+    code = generate_backstage_command(str(path), output=str(out))
+    return {"exit": code, "files": env.files(out) if out.is_dir() else {}}
+
+
+def simulate(path: Path, env: Env) -> Any:
+    env.discard_output()
+    code = simulate_command(str(path), seed=42, num_runs=200, output_format="json")
+    # Exit 2 is an error (no JSON printed); only 0 and 1 carry a result.
+    return {"exit": code, "json": env.stdout_json() if code in (0, 1) else None}
+
+
+def topology(path: Path, env: Env) -> Any:
+    # The command gates on a provider (a Prometheus URL) and then asks it for
+    # the graph. Satisfy the gate with a URL and replace build_graph, so the
+    # command runs load_manifest -> build_topology -> serialise with no
+    # network. The graph is constructed input derived only from the
+    # manifest's declared dependencies (as in the generator topology cell).
+    # A manifest that stops loading changes the exit code to 2 and the file to null.
+    async def build_graph(self: Any, names: Any) -> Any:
+        return _graph_from_declared_dependencies(_load(path))
+
+    env.monkeypatch.setenv("NTHLAYER_PROMETHEUS_URL", "http://prometheus.invalid")
+    env.monkeypatch.setattr(DependencyDiscovery, "build_graph", build_graph)
+    out = env.tmp / "topology.json"
+    code = topology_export_command(str(path), output_file=str(out))
+    return {"exit": code, "topology": json.loads(out.read_text()) if out.is_file() else None}
+
+
+class _Detector:
+    """Serves the shipped policies.yaml rules as a service's PolicyRules."""
+
+    def get_resources_by_kind(self, kind: str) -> list[dict[str, Any]]:
+        if kind != "PolicyRules":
+            return []
+        rules = yaml.safe_load(POLICIES.read_text(encoding="utf-8"))["rules"]
+        return [{"spec": {"rules": rules}}]
+
+
+def policy_handler(path: Path, env: Env) -> Any:
+    # The handler returns only a count; record the report it evaluates so the
+    # violations are pinned too.
+    reports: list[PolicyReport] = []
+    real_evaluate = PolicyEngine.evaluate
+
+    def recording_evaluate(self: PolicyEngine, manifest: Any) -> PolicyReport:
+        report = real_evaluate(self, manifest)
+        reports.append(report)
+        return report
+
+    env.monkeypatch.setattr(PolicyEngine, "evaluate", recording_evaluate)
+    ctx = OrchestratorContext(
+        service_yaml=path,
+        service_def={},
+        service_name=path.stem,
+        output_dir=env.tmp,
+        env=None,
+        detector=_Detector(),
+    )
+    count = PolicyHandler().generate(ctx)
+    env.discard_output()
+    return {"rules_evaluated": count, "reports": reports}
+
+
+CELLS: dict[str, Callable[[Path, Env], Any]] = {
+    "cli_migrate": migrate,
+    "cli_validate": validate,
+    "cli_alerts_evaluate": alerts_evaluate,
+    "cli_alerts_show": alerts_show,
+    "cli_alerts_test": alerts_test,
+    "cli_docs": docs,
+    "cli_backstage": backstage,
+    "cli_simulate": simulate,
+    "cli_topology": topology,
+    "cli_policy_handler": policy_handler,
+}
+GOLDEN_CELLS = {cell: tuple(IDS) for cell in CELLS}
+
+
+@pytest.mark.parametrize("cell", sorted(CELLS))
+@pytest.mark.parametrize(("mid", "path"), CASES, ids=IDS)
+def test_cli(
+    cell: str,
+    mid: str,
+    path: Path,
+    tmp_path: Path,
+    capsys: pytest.CaptureFixture[str],
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    # No provider and no live Prometheus: the environment must not change a cell.
+    for var in ("NTHLAYER_PROMETHEUS_URL", "NTHLAYER_METRICS_USER", "NTHLAYER_METRICS_PASSWORD"):
+        monkeypatch.delenv(var, raising=False)
+    env = Env(tmp_path, capsys, monkeypatch)
+    try:
+        value = CELLS[cell](path, env)
+    except Exception as e:  # noqa: BLE001 — today's failure is the golden
+        value = _error(e)
+    check(cell, mid, value, tmp=tmp_path)
diff --git a/tests/golden/test_golden_generators.py b/tests/golden/test_golden_generators.py
new file mode 100644
index 0000000..47ba9be
--- /dev/null
+++ b/tests/golden/test_golden_generators.py
@@ -0,0 +1,279 @@
+"""Library-generator cells: every manifest-path generator over the corpus (spec §6.2).
+
+One test function per cell, each parametrised over the srm/v1, legacy and
+OpenSRM v2 manifests that load today. The loadable set is found by loading
+the corpus (the same call the ``load`` cell pins), not hard-coded, so a manifest that
+starts or stops loading moves in or out of these cells — and the ``load``
+golden for it changes in the same diff.
+
+A generator that raises (``{"error": [type, message]}``) or reports failure
+in its result (``{"error": message}``) has that failure pinned: today's failure is part of today's behaviour,
+and a manifest that starts or stops failing a generator is a golden diff.
+
+Inputs are the shipped manifests themselves, ``examples/policies.yaml`` and
+``examples/opensrm/`` (the contract registry) — never anything derived from
+the code under test. The one constructed input is the topology cell's
+``DependencyGraph``; see ``_graph_from_declared_dependencies``.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import json
+from collections.abc import Callable
+from pathlib import Path
+from typing import Any
+
+import pytest
+import yaml
+
+from nthlayer_generate.dashboards.manifest_builder import build_dashboard_from_manifest
+from nthlayer_generate.generators.alerts import generate_alerts_from_manifest
+from nthlayer_generate.generators.backstage import generate_backstage_entity
+from nthlayer_generate.generators.docs import generate_service_docs
+from nthlayer_generate.generators.sloth import generate_sloth_from_manifest
+from nthlayer_generate.loki.generator import generate_loki_alerts_from_manifest
+from nthlayer_generate.metrics.recommender import recommend_metrics_from_manifest
+from nthlayer_generate.policies.engine import PolicyEngine
+from nthlayer_generate.recording_rules.manifest_builder import (
+    build_recording_rules_from_manifest,
+)
+from nthlayer_generate.recording_rules.models import create_rule_groups
+from nthlayer_generate.simulate.engine import run_simulation
+from nthlayer_generate.simulate.graph import build_dependency_models, build_failure_models
+from nthlayer_generate.slos.pipeline import AlertPipeline
+from nthlayer_generate.specs.contracts import ContractRegistry
+from nthlayer_generate.specs.validator import validate_service_file
+from nthlayer_generate.topology.enrichment import build_topology
+
+from ._corpus import (
+    EX,
+    LEGACY,
+    SRM_V1,
+    V2,
+    _error,
+    _graph_from_declared_dependencies,
+    _load,
+    manifest_id,
+)
+from ._golden import check
+
+
+def _loads(path: Path) -> bool:
+    try:
+        _load(path)
+    except Exception:  # noqa: BLE001 — the load cell pins why it failed
+        return False
+    return True
+
+
+CASES: tuple[tuple[str, Path], ...] = tuple(
+    (manifest_id(p), p) for p in SRM_V1 + LEGACY + V2 if _loads(p)
+)
+IDS = [i for i, _ in CASES]
+
+
+def _read_yaml(path: Path | None) -> Any:
+    """A written YAML file as structure; ``None`` when nothing was written."""
+    if path is None or not path.is_file():
+        return None
+    return yaml.safe_load(path.read_text(encoding="utf-8"))
+
+
+# --- cells: (manifest path, tmp dir) -> golden value -------------------------
+
+
+def recording_rules(path: Path, tmp: Path) -> Any:
+    groups = build_recording_rules_from_manifest(_load(path))
+    return yaml.safe_load(create_rule_groups(groups))
+
+
+def sloth(path: Path, tmp: Path) -> Any:
+    result = generate_sloth_from_manifest(_load(path), tmp)
+    if not result.success:
+        return {"error": result.error}
+    return _read_yaml(result.output_file)
+
+
+def alerts(path: Path, tmp: Path) -> Any:
+    # No file is written when no alerts are generated; that pins as null.
+    out = tmp / "alerts.yaml"
+    generate_alerts_from_manifest(_load(path), output_file=out, quiet=True)
+    return _read_yaml(out)
+
+
+def dashboard(path: Path, tmp: Path) -> Any:
+    return build_dashboard_from_manifest(_load(path))
+
+
+def loki(path: Path, tmp: Path) -> Any:
+    _alerts, ruler_file = generate_loki_alerts_from_manifest(_load(path), tmp)
+    ruler = _read_yaml(ruler_file)
+    # Rule order follows set iteration over the dependency technologies
+    # (specs/helpers.py:94, ``list(set(technologies))``), so it varies with
+    # PYTHONHASHSEED. Pin the rules as a set: sorted by their full content.
+    # Every rule's content is still pinned; only today's arbitrary order is not.
+    for group in (ruler or {}).get("groups", []):
+        group["rules"] = sorted(group["rules"], key=lambda r: json.dumps(r, sort_keys=True))
+    return ruler
+
+
+def metrics(path: Path, tmp: Path) -> Any:
+    return recommend_metrics_from_manifest(_load(path)).to_dict()
+
+
+def backstage(path: Path, tmp: Path) -> Any:
+    result = generate_backstage_entity(path, tmp)
+    if not result.success:
+        return {"error": result.error}
+    assert result.output_file is not None
+    return json.loads(result.output_file.read_text(encoding="utf-8"))
+
+
+def docs(path: Path, tmp: Path) -> Any:
+    result = generate_service_docs(path, tmp, include_adr=True, include_api=True)
+    if not result.success:
+        return {"error": result.error}
+    # Every file written, not just the ones the result lists.
+    return {
+        p.relative_to(tmp).as_posix(): p.read_text(encoding="utf-8")
+        for p in sorted(tmp.rglob("*"))
+        if p.is_file()
+    }
+
+
+def policies(path: Path, tmp: Path) -> Any:
+    report = PolicyEngine.from_yaml(EX / "policies.yaml").evaluate(_load(path))
+    return dataclasses.asdict(report)
+
+
+def validate(path: Path, tmp: Path) -> Any:
+    # The brief names ``validate_manifest``; no such function exists. The
+    # manifest-path validator is ``validate_service_file`` (specs/validator.py:68).
+    result = validate_service_file(
+        path, contract_registry=ContractRegistry.from_directory(EX / "opensrm")
+    )
+    return {"valid": result.valid, "errors": result.errors, "warnings": result.warnings}
+
+
+def pipeline(path: Path, tmp: Path) -> Any:
+    return AlertPipeline().evaluate_service(_load(path), simulate_burn_pct=50.0).to_dict()
+
+
+def simulate(path: Path, tmp: Path) -> Any:
+    m = _load(path)
+    failure_models = build_failure_models([m])
+    dependency_models = build_dependency_models([m])
+    result = run_simulation(
+        failure_models, dependency_models, num_runs=200, horizon_days=90, seed=42
+    )
+    return {
+        "failure_models": failure_models,
+        "dependency_models": dependency_models,
+        "result": result.to_dict(),
+    }
+
+
+def topology(path: Path, tmp: Path) -> Any:
+    m = _load(path)
+    return build_topology(_graph_from_declared_dependencies(m), manifests=[m]).to_dict()
+
+
+CELLS: dict[str, Callable[[Path, Path], Any]] = {
+    "recording_rules": recording_rules,
+    "sloth": sloth,
+    "alerts": alerts,
+    "dashboard": dashboard,
+    "loki": loki,
+    "metrics": metrics,
+    "backstage": backstage,
+    "docs": docs,
+    "policies": policies,
+    "validate": validate,
+    "pipeline": pipeline,
+    "simulate": simulate,
+    "topology": topology,
+}
+GOLDEN_CELLS = {cell: tuple(IDS) for cell in CELLS}
+
+
+def _run(cell: str, mid: str, path: Path, tmp: Path) -> None:
+    try:
+        value = CELLS[cell](path, tmp)
+    except Exception as e:  # noqa: BLE001 — today's failure is the golden
+        value = _error(e)
+    check(cell, mid, value, tmp=tmp)
+
+
+_cases = pytest.mark.parametrize(("mid", "path"), CASES, ids=IDS)
+
+
+def test_corpus_has_loadable_manifests() -> None:
+    # A loader regression that rejected everything would otherwise empty
+    # every cell below and leave a green, zero-case suite.
+    assert len(CASES) >= len(SRM_V1)
+
+
+@_cases
+def test_recording_rules(mid: str, path: Path, tmp_path: Path) -> None:
+    _run("recording_rules", mid, path, tmp_path)
+
+
+@_cases
+def test_sloth(mid: str, path: Path, tmp_path: Path) -> None:
+    _run("sloth", mid, path, tmp_path)
+
+
