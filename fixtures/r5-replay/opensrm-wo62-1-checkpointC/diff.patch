index 0000000..d4bb2a9
--- /dev/null
+++ b/tests/golden/data/alerts/services__payment-api.json
@@ -0,0 +1,249 @@
+{
+  "groups": [
+    {
+      "name": "payment-api-postgresql",
+      "rules": [
+        {
+          "alert": "PostgresqlDown",
+          "annotations": {
+            "description": "Postgresql instance is down\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Postgresql down (instance {{ $labels.instance }})"
+          },
+          "expr": "pg_up == 0",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "payment-api",
+            "severity": "critical",
+            "team": "payments",
+            "tier": "critical"
+          }
+        },
+        {
+          "alert": "PostgresqlRestarted",
+          "annotations": {
+            "description": "Postgresql restarted\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Postgresql restarted (instance {{ $labels.instance }})"
+          },
+          "expr": "time() - pg_postmaster_start_time_seconds < 60",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "payment-api",
+            "severity": "critical",
+            "team": "payments",
+            "tier": "critical"
+          }
+        },
+        {
+          "alert": "PostgresqlExporterError",
+          "annotations": {
+            "description": "Postgresql exporter is showing errors. A query may be buggy in query.yaml\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Postgresql exporter error (instance {{ $labels.instance }})"
+          },
+          "expr": "pg_exporter_last_scrape_error > 0",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "payment-api",
+            "severity": "critical",
+            "team": "payments",
+            "tier": "critical"
+          }
+        },
+        {
+          "alert": "PostgresqlTableNotAutoVacuumed",
+          "annotations": {
+            "description": "Table {{ $labels.relname }} has not been auto vacuumed for 10 days\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Postgresql table not auto vacuumed (instance {{ $labels.instance }})"
+          },
+          "expr": "(pg_stat_user_tables_last_autovacuum > 0) and (time() - pg_stat_user_tables_last_autovacuum) > 60 * 60 * 24 * 10",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "payment-api",
+            "severity": "warning",
+            "team": "payments",
+            "tier": "critical"
+          }
+        },
+        {
+          "alert": "PostgresqlTableNotAutoAnalyzed",
+          "annotations": {
+            "description": "Table {{ $labels.relname }} has not been auto analyzed for 10 days\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Postgresql table not auto analyzed (instance {{ $labels.instance }})"
+          },
+          "expr": "(pg_stat_user_tables_last_autoanalyze > 0) and (time() - pg_stat_user_tables_last_autoanalyze) > 60 * 60 * 24 * 10",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "payment-api",
+            "severity": "warning",
+            "team": "payments",
+            "tier": "critical"
+          }
+        },
+        {
+          "alert": "PostgresqlTooManyConnections",
+          "annotations": {
+            "description": "PostgreSQL instance has too many connections (> 80%).\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Postgresql too many connections (instance {{ $labels.instance }})"
+          },
+          "expr": "sum by (instance, job, server) (pg_stat_activity_count) > min by (instance, job, server) (pg_settings_max_connections * 0.8)",
+          "for": "2m",
+          "labels": {
+            "routing": "self",
+            "service": "payment-api",
+            "severity": "warning",
+            "team": "payments",
+            "tier": "critical"
+          }
+        },
+        {
+          "alert": "PostgresqlNotEnoughConnections",
+          "annotations": {
+            "description": "PostgreSQL instance should have more connections (> 5)\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Postgresql not enough connections (instance {{ $labels.instance }})"
+          },
+          "expr": "sum by (instance, job, server) (pg_stat_activity_count) < 5",
+          "for": "2m",
+          "labels": {
+            "routing": "self",
+            "service": "payment-api",
+            "severity": "warning",
+            "team": "payments",
+            "tier": "critical"
+          }
+        },
+        {
+          "alert": "PostgresqlDeadLocks",
+          "annotations": {
+            "description": "PostgreSQL has dead-locks\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Postgresql dead locks (instance {{ $labels.instance }})"
+          },
+          "expr": "increase(pg_stat_database_deadlocks{datname!~\"template.*|postgres\"}[1m]) > 5",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "payment-api",
+            "severity": "warning",
+            "team": "payments",
+            "tier": "critical"
+          }
+        },
+        {
+          "alert": "PostgresqlHighRollbackRate",
+          "annotations": {
+            "description": "Ratio of transactions being aborted compared to committed is > 2 %\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Postgresql high rollback rate (instance [instance unavailable])"
+          },
+          "expr": "sum by (namespace,datname) ((rate(pg_stat_database_xact_rollback{datname!~\"template.*|postgres\",datid!=\"0\"}[3m])) / ((rate(pg_stat_database_xact_rollback{datname!~\"template.*|postgres\",datid!=\"0\"}[3m])) + (rate(pg_stat_database_xact_commit{datname!~\"template.*|postgres\",datid!=\"0\"}[3m])))) > 0.02",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "payment-api",
+            "severity": "warning",
+            "team": "payments",
+            "tier": "critical"
+          }
+        },
+        {
+          "alert": "PostgresqlCommitRateLow",
+          "annotations": {
+            "description": "Postgresql seems to be processing very few transactions\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Postgresql commit rate low (instance {{ $labels.instance }})"
+          },
+          "expr": "rate(pg_stat_database_xact_commit[1m]) < 10",
+          "for": "2m",
+          "labels": {
+            "routing": "self",
+            "service": "payment-api",
+            "severity": "critical",
+            "team": "payments",
+            "tier": "critical"
+          }
+        },
+        {
+          "alert": "PostgresqlLowXidConsumption",
+          "annotations": {
+            "description": "Postgresql seems to be consuming transaction IDs very slowly\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Postgresql low XID consumption (instance {{ $labels.instance }})"
+          },
+          "expr": "rate(pg_txid_current[1m]) < 5",
+          "for": "2m",
+          "labels": {
+            "routing": "self",
+            "service": "payment-api",
+            "severity": "warning",
+            "team": "payments",
+            "tier": "critical"
+          }
+        },
+        {
+          "alert": "PostgresqlHighRateStatementTimeout",
+          "annotations": {
+            "description": "Postgres transactions are showing high rate of statement timeouts\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Postgresql high rate statement timeout (instance {{ $labels.instance }})"
+          },
+          "expr": "rate(postgresql_errors_total{type=\"statement_timeout\"}[1m]) > 3",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "payment-api",
+            "severity": "critical",
+            "team": "payments",
+            "tier": "critical"
+          }
+        },
+        {
+          "alert": "PostgresqlHighRateDeadlock",
+          "annotations": {
+            "description": "Postgres detected deadlocks\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Postgresql high rate deadlock (instance {{ $labels.instance }})"
+          },
+          "expr": "increase(postgresql_errors_total{type=\"deadlock_detected\"}[1m]) > 1",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "payment-api",
+            "severity": "critical",
+            "team": "payments",
+            "tier": "critical"
+          }
+        },
+        {
+          "alert": "PostgresqlUnusedReplicationSlot",
+          "annotations": {
+            "description": "Unused Replication Slots\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Postgresql unused replication slot (instance {{ $labels.instance }})"
+          },
+          "expr": "pg_replication_slots_active == 0",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "payment-api",
+            "severity": "warning",
+            "team": "payments",
+            "tier": "critical"
+          }
+        },
+        {
+          "alert": "PostgresqlTooManyDeadTuples",
+          "annotations": {
+            "description": "PostgreSQL dead tuples is too large\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Postgresql too many dead tuples (instance {{ $labels.instance }})"
+          },
+          "expr": "((pg_stat_user_tables_n_dead_tup > 10000) / (pg_stat_user_tables_n_live_tup + pg_stat_user_tables_n_dead_tup)) >= 0.1",
+          "for": "2m",
+          "labels": {
+            "routing": "self",
+            "service": "payment-api",
+            "severity": "warning",
+            "team": "payments",
+            "tier": "critical"
+          }
+        }
+      ]
+    }
+  ]
+}
diff --git a/tests/golden/data/alerts/services__search-api.json b/tests/golden/data/alerts/services__search-api.json
new file mode 100644
index 0000000..0d681aa
--- /dev/null
+++ b/tests/golden/data/alerts/services__search-api.json
@@ -0,0 +1,510 @@
+{
+  "groups": [
+    {
+      "name": "search-api-elasticsearch",
+      "rules": [
+        {
+          "alert": "ElasticsearchHeapUsageTooHigh",
+          "annotations": {
+            "description": "The heap usage is over 90%\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Elasticsearch Heap Usage Too High (instance {{ $labels.instance }})"
+          },
+          "expr": "(elasticsearch_jvm_memory_used_bytes{area=\"heap\"} / elasticsearch_jvm_memory_max_bytes{area=\"heap\"}) * 100 > 90",
+          "for": "2m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "critical",
+            "team": "search",
+            "tier": "high"
+          }
+        },
+        {
+          "alert": "ElasticsearchHeapUsageWarning",
+          "annotations": {
+            "description": "The heap usage is over 80%\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Elasticsearch Heap Usage warning (instance {{ $labels.instance }})"
+          },
+          "expr": "(elasticsearch_jvm_memory_used_bytes{area=\"heap\"} / elasticsearch_jvm_memory_max_bytes{area=\"heap\"}) * 100 > 80",
+          "for": "2m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "warning",
+            "team": "search",
+            "tier": "high"
+          }
+        },
+        {
+          "alert": "ElasticsearchDiskOutOfSpace",
+          "annotations": {
+            "description": "The disk usage is over 90%\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Elasticsearch disk out of space (instance {{ $labels.instance }})"
+          },
+          "expr": "elasticsearch_filesystem_data_available_bytes / elasticsearch_filesystem_data_size_bytes * 100 < 10",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "critical",
+            "team": "search",
+            "tier": "high"
+          }
+        },
+        {
+          "alert": "ElasticsearchDiskSpaceLow",
+          "annotations": {
+            "description": "The disk usage is over 80%\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Elasticsearch disk space low (instance {{ $labels.instance }})"
+          },
+          "expr": "elasticsearch_filesystem_data_available_bytes / elasticsearch_filesystem_data_size_bytes * 100 < 20",
+          "for": "2m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "warning",
+            "team": "search",
+            "tier": "high"
+          }
+        },
+        {
+          "alert": "ElasticsearchClusterRed",
+          "annotations": {
+            "description": "Elastic Cluster Red status\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Elasticsearch Cluster Red (instance {{ $labels.instance }})"
+          },
+          "expr": "elasticsearch_cluster_health_status{color=\"red\"} == 1",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "critical",
+            "team": "search",
+            "tier": "high"
+          }
+        },
+        {
+          "alert": "ElasticsearchClusterYellow",
+          "annotations": {
+            "description": "Elastic Cluster Yellow status\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Elasticsearch Cluster Yellow (instance {{ $labels.instance }})"
+          },
+          "expr": "elasticsearch_cluster_health_status{color=\"yellow\"} == 1",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "warning",
+            "team": "search",
+            "tier": "high"
+          }
+        },
+        {
+          "alert": "ElasticsearchHealthyNodes",
+          "annotations": {
+            "description": "Missing node in Elasticsearch cluster\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Elasticsearch Healthy Nodes (instance {{ $labels.instance }})"
+          },
+          "expr": "elasticsearch_cluster_health_number_of_nodes < 3",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "critical",
+            "team": "search",
+            "tier": "high"
+          }
+        },
+        {
+          "alert": "ElasticsearchHealthyDataNodes",
+          "annotations": {
+            "description": "Missing data node in Elasticsearch cluster\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Elasticsearch Healthy Data Nodes (instance {{ $labels.instance }})"
+          },
+          "expr": "elasticsearch_cluster_health_number_of_data_nodes < 3",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "critical",
+            "team": "search",
+            "tier": "high"
+          }
+        },
+        {
+          "alert": "ElasticsearchRelocatingShards",
+          "annotations": {
+            "description": "Elasticsearch is relocating shards\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Elasticsearch relocating shards (instance {{ $labels.instance }})"
+          },
+          "expr": "elasticsearch_cluster_health_relocating_shards > 0",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "info",
+            "team": "search",
+            "tier": "high"
+          }
+        },
+        {
+          "alert": "ElasticsearchRelocatingShardsTooLong",
+          "annotations": {
+            "description": "Elasticsearch has been relocating shards for 15min\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Elasticsearch relocating shards too long (instance {{ $labels.instance }})"
+          },
+          "expr": "elasticsearch_cluster_health_relocating_shards > 0",
+          "for": "15m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "warning",
+            "team": "search",
+            "tier": "high"
+          }
+        },
+        {
+          "alert": "ElasticsearchInitializingShards",
+          "annotations": {
+            "description": "Elasticsearch is initializing shards\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Elasticsearch initializing shards (instance {{ $labels.instance }})"
+          },
+          "expr": "elasticsearch_cluster_health_initializing_shards > 0",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "info",
+            "team": "search",
+            "tier": "high"
+          }
+        },
+        {
+          "alert": "ElasticsearchInitializingShardsTooLong",
+          "annotations": {
+            "description": "Elasticsearch has been initializing shards for 15 min\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Elasticsearch initializing shards too long (instance {{ $labels.instance }})"
+          },
+          "expr": "elasticsearch_cluster_health_initializing_shards > 0",
+          "for": "15m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "warning",
+            "team": "search",
+            "tier": "high"
+          }
+        },
+        {
+          "alert": "ElasticsearchUnassignedShards",
+          "annotations": {
+            "description": "Elasticsearch has unassigned shards\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Elasticsearch unassigned shards (instance {{ $labels.instance }})"
+          },
+          "expr": "elasticsearch_cluster_health_unassigned_shards > 0",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "critical",
+            "team": "search",
+            "tier": "high"
+          }
+        },
+        {
+          "alert": "ElasticsearchPendingTasks",
+          "annotations": {
+            "description": "Elasticsearch has pending tasks. Cluster works slowly.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Elasticsearch pending tasks (instance {{ $labels.instance }})"
+          },
+          "expr": "elasticsearch_cluster_health_number_of_pending_tasks > 0",
+          "for": "15m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "warning",
+            "team": "search",
+            "tier": "high"
+          }
+        },
+        {
+          "alert": "ElasticsearchNoNewDocuments",
+          "annotations": {
+            "description": "No new documents for 10 min!\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Elasticsearch no new documents (instance {{ $labels.instance }})"
+          },
+          "expr": "increase(elasticsearch_indices_indexing_index_total{es_data_node=\"true\"}[10m]) < 1",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "warning",
+            "team": "search",
+            "tier": "high"
+          }
+        },
+        {
+          "alert": "ElasticsearchHighIndexingLatency",
+          "annotations": {
+            "description": "The indexing latency on Elasticsearch cluster is higher than the threshold.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Elasticsearch High Indexing Latency (instance {{ $labels.instance }})"
+          },
+          "expr": "increase(elasticsearch_indices_indexing_index_time_seconds_total[1m]) / increase(elasticsearch_indices_indexing_index_total[1m]) > 0.0005",
+          "for": "10m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "warning",
+            "team": "search",
+            "tier": "high"
+          }
+        },
+        {
+          "alert": "ElasticsearchHighIndexingRate",
+          "annotations": {
+            "description": "The indexing rate on Elasticsearch cluster is higher than the threshold.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Elasticsearch High Indexing Rate (instance [instance unavailable])"
+          },
+          "expr": "sum(rate(elasticsearch_indices_indexing_index_total[1m]))> 10000",
+          "for": "5m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "warning",
+            "team": "search",
+            "tier": "high"
+          }
+        },
+        {
+          "alert": "ElasticsearchHighQueryRate",
+          "annotations": {
+            "description": "The query rate on Elasticsearch cluster is higher than the threshold.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Elasticsearch High Query Rate (instance [instance unavailable])"
+          },
+          "expr": "sum(rate(elasticsearch_indices_search_query_total[1m])) > 100",
+          "for": "5m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "warning",
+            "team": "search",
+            "tier": "high"
+          }
+        },
+        {
+          "alert": "ElasticsearchHighQueryLatency",
+          "annotations": {
+            "description": "The query latency on Elasticsearch cluster is higher than the threshold.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Elasticsearch High Query Latency (instance {{ $labels.instance }})"
+          },
+          "expr": "increase(elasticsearch_indices_search_fetch_time_seconds[1m]) / increase(elasticsearch_indices_search_fetch_total[1m]) > 1",
+          "for": "5m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "warning",
+            "team": "search",
+            "tier": "high"
+          }
+        }
+      ]
+    },
+    {
+      "name": "search-api-redis",
+      "rules": [
+        {
+          "alert": "RedisDown",
+          "annotations": {
+            "description": "Redis instance is down\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Redis down (instance {{ $labels.instance }})"
+          },
+          "expr": "redis_up == 0",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "critical",
+            "team": "search",
+            "tier": "high"
+          }
+        },
+        {
+          "alert": "RedisMissingMaster",
+          "annotations": {
+            "description": "Redis cluster has no node marked as master.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Redis missing master (instance [instance unavailable])"
+          },
+          "expr": "(count(redis_instance_info{role=\"master\"}) or vector(0)) < 1",
+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "search-api",
+            "severity": "critical",
+            "team": "search",
+            "tier": "high"
+          }
+        },
+        {
+          "alert": "RedisTooManyMasters",
+          "annotations": {
+            "description": "Redis cluster has too many nodes marked as master.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
+            "summary": "Redis too many masters (instance [instance unavailable])"
+          },
+          "expr": "count(redis_instance_info{role=\"master\"}) > 1",
+          "for": "1m",
