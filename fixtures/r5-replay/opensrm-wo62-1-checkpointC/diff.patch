+          "for": "1m",
+          "labels": {
+            "routing": "self",
+            "service": "checkout-service",
+            "severity": "critical",
+            "team": "commerce",
+            "tier": "critical"
+          }
+        },
+        {
+          "alert": "RedisDisconnectedSlaves",
