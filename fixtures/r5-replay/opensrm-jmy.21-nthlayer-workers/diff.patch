+def _run(statuses, interval=INTERVAL):
+    """One status per threshold interval, starting at t=0."""
+    st, fired = KeyState(), []
+    for i, s in enumerate(statuses):
+        st, f = advance(st, s, i * interval, REARM)
+        fired.append(f)
+    return fired
