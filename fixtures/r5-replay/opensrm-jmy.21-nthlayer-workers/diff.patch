+        state = WalkthroughState.for_plan(plan)
+
+        # Navigate to rec-c, accept it first.
+        state = next_rec(state)   # → rec-b
+        state = next_rec(state)   # → rec-c
+        state = accept(state)     # accepts rec-c, index advances to 3
