+def test_manifest_alerts_go_through_validation():
+    """A template's ``for: 0m`` is raised to 1m on the manifest path.
+
+    Ported from the legacy TestAlertValidationIntegration (opensrm-wo62.4.22).
+    alerts/templates/brokers/rabbitmq.yaml ships two ``for: 0m`` rules, and
+    examples/services/email-worker.yaml depends on rabbitmq, so validation
+    has a real zero to fix.
+    """
+    from nthlayer_common.manifest import load_manifest
+
+    from nthlayer_generate.generators.alerts import generate_alerts_from_manifest
+
+    zero = {"0m", "0s", ""}
+    raw_zero = {
+        rule.name
+        for rule in AlertTemplateLoader().load_technology("rabbitmq")
+        if rule.duration in zero
+    }
+    assert raw_zero, "rabbitmq.yaml no longer ships a for: 0m rule; pick another"
+
+    manifest = load_manifest(
+        Path(__file__).resolve().parents[1] / "examples" / "services" / "email-worker.yaml",
+        suppress_deprecation_warning=True,
+    )
+    durations = {
+        alert.name: alert.duration for alert in generate_alerts_from_manifest(manifest, quiet=True)
+    }
+
+    assert {name: durations.get(name) for name in raw_zero} == dict.fromkeys(raw_zero, "1m")
+    assert not [name for name, duration in durations.items() if duration in zero]
diff --git a/tests/test_dashboard_technology_dedup.py b/tests/test_dashboard_technology_dedup.py
new file mode 100644
index 0000000..f0cf27d
--- /dev/null
+++ b/tests/test_dashboard_technology_dedup.py
@@ -0,0 +1,63 @@
+"""One set of technology panels per technology, however many dependencies use it.
+
+Ported from the legacy builder's test_templates_avoid_duplicates
+(opensrm-wo62.4.22, ruling J2). On the manifest path a second postgres
+dependency used to add the ten PostgreSQL panels again, with identical
+queries: the panels describe the technology, not the instance.
+
+The input is examples/services/payment-api-with-deps.yaml with its own
+postgres-main entry copied under a new name, so the dependency shape is the
+shipped one. No shipped manifest repeats a technology on its own, but three
+shipped env overlays do once merged (examples/environments/payment-api-dev,
+payment-api-prod and search-api-prod add a second Dependencies resource), and
+the staged env golden cells pin that case end to end.
+"""
+
+from __future__ import annotations
+
+import copy
+from pathlib import Path
+from typing import Any
+
+import pytest
+import yaml
+from nthlayer_common.manifest import load_manifest
+
+from nthlayer_generate.dashboards.manifest_builder import build_dashboard_from_manifest
+
+SHIPPED = (
+    Path(__file__).resolve().parents[1] / "examples" / "services" / "payment-api-with-deps.yaml"
+)
+
+
+def _panel_titles(manifest_path: Path) -> list[str]:
+    manifest = load_manifest(manifest_path, suppress_deprecation_warning=True)
+    titles = []
+    for panel in build_dashboard_from_manifest(manifest)["dashboard"]["panels"]:
+        titles.append(panel["title"])
+        titles.extend(child["title"] for child in panel.get("panels", []))
+    return titles
+
+
+def _with_postgres_twin(tmp_path: Path, twin_type: str) -> Path:
+    data: dict[str, Any] = yaml.safe_load(SHIPPED.read_text(encoding="utf-8"))
+    (deps,) = [r for r in data["resources"] if r["kind"] == "Dependencies"]
+    databases = deps["spec"]["databases"]
+    (postgres,) = [db for db in databases if db["name"] == "postgres-main"]
+    twin = copy.deepcopy(postgres)
+    twin["name"] = "postgres-replica"
+    twin["type"] = twin_type
+    databases.append(twin)
+    path = tmp_path / SHIPPED.name
+    path.write_text(yaml.safe_dump(data), encoding="utf-8")
+    return path
+
+
+# "postgres" repeats the shipped entry's type; "postgresql" is the alias the
+# other shipped examples use, which resolves to the same dashboard template.
+@pytest.mark.parametrize("twin_type", ["postgres", "postgresql"])
+def test_a_second_dependency_on_a_technology_adds_no_panels(tmp_path: Path, twin_type: str):
+    baseline = _panel_titles(SHIPPED)
+    assert "PostgreSQL Connections" in baseline  # the shipped file has postgres panels
+
+    assert _panel_titles(_with_postgres_twin(tmp_path, twin_type)) == baseline
diff --git a/tests/test_recording_rules.py b/tests/test_recording_rules.py
index 7272e2f..ed310c4 100644
--- a/tests/test_recording_rules.py
+++ b/tests/test_recording_rules.py
@@ -235,5 +235,81 @@ resources:
             assert len(rules_data["groups"]) >= 1
 
 
+# --- manifest path (ported from the legacy builder's tests, opensrm-wo62.4.22) ---
+
+EXAMPLES = Path(__file__).resolve().parents[1] / "examples"
+# Every shipped legacy and srm/v1 manifest. The count is pinned so a moved
+# examples directory fails here instead of leaving the loop empty.
+SHIPPED = sorted((EXAMPLES / "services").glob("*.yaml")) + sorted(
+    (EXAMPLES / "opensrm").glob("*.reliability.yaml")
+)
+
+
+def _load(path: Path):
+    from nthlayer_common.manifest import load_manifest
+
+    return load_manifest(path, suppress_deprecation_warning=True)
+
+
+def _rules(path: Path):
+    from nthlayer_generate.recording_rules import build_recording_rules_from_manifest
+
+    return [r for g in build_recording_rules_from_manifest(_load(path)) for r in g.rules]
+
+
+def test_shipped_corpus_is_present():
+    assert len(SHIPPED) == 23, [p.name for p in SHIPPED]
+
+
+@pytest.mark.parametrize("path", SHIPPED, ids=lambda p: p.name)
+def test_shipped_rules_follow_prometheus_conventions(path: Path):
+    """Every record is level:metric:operation style, no edge underscores."""
+    rules = _rules(path)
+    assert rules, f"{path.name} produced no recording rules"
+    for rule in rules:
+        assert ":" in rule.record, rule.record
+        assert not rule.record.startswith("_"), rule.record
+        assert not rule.record.endswith("_"), rule.record
+
+
+@pytest.mark.parametrize("path", SHIPPED, ids=lambda p: p.name)
+def test_shipped_rules_carry_the_service_label(path: Path):
+    service = _load(path).name
+    rules = _rules(path)
+    assert rules, f"{path.name} produced no recording rules"
+    for rule in rules:
+        assert rule.labels.get("service") == service, (rule.record, rule.labels)
+
+
+PAYMENT_API = EXAMPLES / "services" / "payment-api.yaml"
+
+
+def _records_for_slo(path: Path, slo: str) -> set[str]:
+    return {r.record for r in _rules(path) if r.labels.get("slo") == slo}
+
+
+def test_availability_slo_rules():
+    # payment-api.yaml declares an availability SLO with a 30d window.
+    assert _records_for_slo(PAYMENT_API, "availability") >= {
+        "slo:requests_total:30d",
+        "slo:requests_success:30d",
+        "slo:availability:ratio",
+        "slo:error_budget_remaining:ratio",
+    }
+
+
+def test_latency_slo_rules():
+    # payment-api.yaml declares latency-p95 (a legacy latency SLO with a
+    # threshold, 30d window). Not an srm/v1 example: those write latency as
+    # target: <ms>, which the v1 schema rejects (opensrm-jlbm).
+    assert _records_for_slo(PAYMENT_API, "latency-p95") >= {
+        "slo:latency_requests_total:30d",
+        "slo:latency_requests_fast:30d",
+        "slo:latency:ratio",
+        "slo:http_request_duration_seconds:p95",
+        "slo:http_request_duration_seconds:p99",
+    }
+
+
 if __name__ == "__main__":
     pytest.main([__file__, "-v"])
