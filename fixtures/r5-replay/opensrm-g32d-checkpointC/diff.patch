+    assert m._threshold_state[_suffixed(_CAL)]["last_evaluable"] == "breach"   # 0.1 > 0.05
+    assert m._threshold_state[_suffixed(_CAL_02)]["last_evaluable"] == "within"  # 0.1 <= 0.2
+    assert len(_breaches(v)) == 1  # the swap re-raised nothing
+
