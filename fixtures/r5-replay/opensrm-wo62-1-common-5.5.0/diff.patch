+# Vendored from rsionnach/nthlayer-generate examples/uat/payment-api.yaml
+# at commit 6e71305 (opensrm-wo62.1). Copied verbatim below this header so
+# nthlayer-common CI, which checks out only opensrm beside the repo, can load
+# a shipped legacy-format manifest. Do not edit; re-vendor instead.
+
+# Payment API - UAT Service Definition
+# Matches metrics from fake-payment-api container
+
+service:
+  name: payment-api
+  team: payments-team
+  tier: critical
+  type: api
+
+resources:
+  # Availability SLO - matches fake service metrics
+  - kind: SLO
+    name: availability
+    spec:
+      objective: 99.9
+      window: 30d
+      indicator:
+        type: availability
+        query: |
+          sum(rate(http_requests_total{service="payment-api",status=~"[1234].."}[5m]))
+          /
+          sum(rate(http_requests_total{service="payment-api"}[5m]))
+
+  # Latency SLO - p95
+  - kind: SLO
+    name: latency-p95
+    spec:
+      objective: 99.0
+      window: 30d
+      indicator:
+        type: latency
+        percentile: 95
+        threshold_ms: 500
+        query: |
+          histogram_quantile(0.95,
+            sum(rate(http_request_duration_seconds_bucket{service="payment-api"}[5m])) by (le)
+          )
+
+  # Alert rules for budget monitoring
+  - kind: Alerts
+    name: alert-rules
+    spec:
+      channels:
+        slack_webhook: "${NTHLAYER_SLACK_WEBHOOK_ALERT}"
+      rules:
+        - name: budget-warning
+          type: budget_threshold
+          slo: availability
+          threshold: 0.75
+          severity: warning
+        - name: budget-critical
+          type: budget_threshold
+          slo: availability
+          threshold: 0.90
+          severity: critical
+        - name: high-burn
+          type: burn_rate
+          slo: "*"
+          threshold: 3.0
+          severity: warning
+      auto_rules: false
+
+  # Dependencies for dashboard generation
+  - kind: Dependencies
+    name: stack
+    spec:
+      databases:
+        - name: postgresql
+          type: postgresql
+          criticality: high
+        - name: redis-cache
+          type: redis
+          criticality: medium
+      messaging:
+        - name: redpanda
+          type: kafka
+          criticality: medium
diff --git a/tests/test_legacy_judgment_type.py b/tests/test_legacy_judgment_type.py
new file mode 100644
index 0000000..5c70872
--- /dev/null
+++ b/tests/test_legacy_judgment_type.py
@@ -0,0 +1,389 @@
+"""Legacy-format judgment SLOs carry judgment_type like srm/v1 (opensrm-wo62.1).
+
+nthlayer-generate dispatches judgment recording rules on
+``SLODefinition.judgment_type``. The srm/v1 parser has always set it for SLO
+names in ``V2_JUDGMENT_SLO_TYPES``; the legacy parser did not, so a
+legacy-format ai-gate manifest loaded with ``judgment_type=None`` on its
+reversal_rate / high_confidence_failure SLOs and generate silently dropped
+their judgment rules.
+
+Fixture provenance:
+
+- The legacy document follows the shape of ``tests/fixtures/legacy-payment-api.yaml``,
+  vendored verbatim from nthlayer-generate ``examples/uat/payment-api.yaml``
+  at 6e71305 — top-level
+  ``service: {name, team, tier, type}`` (all four required by
+  ``_parse_legacy_to_manifest``) and ``resources:`` entries of
+  ``kind: SLO`` with ``spec.objective`` / ``spec.window`` / ``spec.indicator``
+  (the keys ``_extract_slos_from_resources`` reads). Only ``service.type`` and
+  the SLO resource names differ: ``ai-gate`` and the judgment names.
+- No committed legacy artefact uses a judgment or threshold SLO name, so the
+  case under test is hand-built: the resource names come from the shared
+  ``V2_JUDGMENT_SLO_TYPES`` / ``SRM_V1_JUDGMENT_THRESHOLD_TYPES`` constants
+  that srm/v1 also dispatches on. ``test_shipped_legacy_example_unaffected``
+  loads that vendored fixture to show the shipped shape is unchanged.
+- The srm/v1 comparison document is built independently from the srm/v1 shape
+  used by ``tests/test_manifest_parser.py::v1_ai_gate_data`` — flat
+  ``spec.slos`` mapping keyed by SLO name with ``target`` / ``window`` — not
+  derived from the legacy parse result.
+"""
+
+from __future__ import annotations
+
+import warnings
+from pathlib import Path
+
+import pytest
+import yaml
+
+from nthlayer_common.manifest import ManifestLoadError, load_manifest
+from nthlayer_common.manifest.models import SourceFormat
+from nthlayer_common.manifest.parser.loader import LegacyFormatWarning
+from nthlayer_common.manifest.parser.v1 import parse_srm_v1
+
+JUDGMENT_NAMES = ("reversal_rate", "high_confidence_failure")
+
+
+def _legacy_doc() -> dict:
+    return {
+        "service": {
+            "name": "fraud-detect",
+            "team": "payments-ml",
+            "tier": "critical",
+            "type": "ai-gate",
+        },
+        "resources": [
+            {
+                "kind": "SLO",
+                "name": "reversal_rate",
+                "spec": {"objective": 95.0, "window": "30d"},
+            },
+            {
+                "kind": "SLO",
+                "name": "high_confidence_failure",
+                "spec": {"objective": 98.0, "window": "7d"},
+            },
+            {
+                "kind": "SLO",
+                "name": "availability",
+                "spec": {
+                    "objective": 99.9,
+                    "window": "30d",
+                    "indicator": {
+                        "type": "availability",
+                        "query": 'sum(rate(http_requests_total{status=~"2.."}[5m]))'
+                        " / sum(rate(http_requests_total[5m]))",
+                    },
+                },
+            },
+        ],
+    }
+
+
+def _srm_v1_doc() -> dict:
+    return {
+        "apiVersion": "srm/v1",
+        "kind": "ServiceReliabilityManifest",
+        "metadata": {"name": "fraud-detect", "team": "payments-ml", "tier": "critical"},
+        "spec": {
+            "type": "ai-gate",
+            "slos": {
+                "reversal_rate": {"target": 95.0, "window": "30d"},
+                "high_confidence_failure": {"target": 98.0, "window": "7d"},
+            },
+        },
+    }
+
+
+@pytest.fixture
+def legacy_manifest(tmp_path):
+    path = tmp_path / "fraud-detect.yaml"
+    path.write_text(yaml.safe_dump(_legacy_doc(), sort_keys=False))
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore")
+        manifest = load_manifest(path)
+    assert manifest.source_format == SourceFormat.LEGACY
+    return manifest
+
+
+def _by_name(manifest):
+    return {s.name: s for s in manifest.slos}
+
+
+@pytest.mark.parametrize("name", JUDGMENT_NAMES)
+def test_legacy_judgment_slo_sets_judgment_type(legacy_manifest, name):
+    assert _by_name(legacy_manifest)[name].judgment_type == name
+
+
+def test_legacy_get_judgment_slos_returns_judgment_slos(legacy_manifest):
+    assert sorted(s.name for s in legacy_manifest.get_judgment_slos()) == sorted(JUDGMENT_NAMES)
+    assert [s.name for s in legacy_manifest.get_standard_slos()] == ["availability"]
+
+
+@pytest.mark.parametrize("name", JUDGMENT_NAMES)
+def test_legacy_judgment_fields_match_srm_v1(legacy_manifest, name):
+    legacy = _by_name(legacy_manifest)[name]
+    v1 = _by_name(parse_srm_v1(_srm_v1_doc()))[name]
+
+    assert v1.judgment_type == name  # the reference really is a judgment SLO
+    assert legacy.judgment_type == v1.judgment_type
+    assert legacy.slo_type == v1.slo_type
+    assert legacy.window == v1.window
+    assert legacy.measurement is not None
+    assert legacy.measurement == v1.measurement
+    assert legacy.statistical_requirements is not None
+    assert legacy.statistical_requirements == v1.statistical_requirements
+
+
+def test_legacy_judgment_measurement_uses_resource_window(legacy_manifest):
+    # Different windows on the two judgment resources, so a hard-coded
+    # window in the legacy path would fail one of them.
+    slos = _by_name(legacy_manifest)
+    assert slos["reversal_rate"].measurement.window == "30d"
+    assert slos["high_confidence_failure"].measurement.window == "7d"
+
+
+def test_legacy_non_judgment_slo_unchanged(legacy_manifest):
+    slo = _by_name(legacy_manifest)["availability"]
+    assert slo.judgment_type is None
+    assert slo.measurement is None
+    assert slo.statistical_requirements is None
+    assert slo.is_judgment_slo() is False
+    assert slo.slo_type == "availability"
+    assert slo.target == 99.9
+    assert slo.window == "30d"
+    assert slo.indicator_query.startswith("sum(rate(http_requests_total")
+
+
+# =============================================================================
+# Judgment thresholds: calibration / feedback_latency
+# =============================================================================
+#
+# srm/v1 lifts these two names out of spec.slos into JudgmentThresholds via
+# thresholds.srm_v1_threshold, because they bound an error magnitude rather
+# than a success rate and so are thresholds, not SLOs; before generate
+# switched to judgment_type dispatch it emitted ai_gate:calibration:* and
+# ai_gate:feedback_latency:* for them in legacy manifests too. Legacy must lift
+# them the same way rather than load them as availability SLOs.
+#
+# Legacy shape: tests/fixtures/legacy-payment-api.yaml's kind: SLO
+# resources (spec.objective, spec.window). The legacy ``unit`` key has no
+# shipped source: no committed legacy manifest uses it. It traces to the
+# loader's pre-existing ``spec.get("unit")`` read in
+# _extract_slos_from_resources, which mirrors srm/v1's ``unit``. srm/v1 shape: the keys srm_v1_threshold accepts
+# (_SRM_V1_THRESHOLD_KEYS = target, window, unit, description, labels;
+# calibration takes no unit; feedback_latency's unit defaults to s and its
+# window must be 30d or absent).
+
+
+def _legacy_threshold_doc() -> dict:
+    doc = _legacy_doc()
+    doc["resources"] += [
+        {"kind": "SLO", "name": "calibration", "spec": {"objective": 0.05, "window": "30d"}},
+        {"kind": "SLO", "name": "feedback_latency", "spec": {"objective": 3600, "unit": "s"}},
+    ]
+    return doc
+
+
+def _srm_v1_threshold_doc() -> dict:
+    doc = _srm_v1_doc()
+    doc["spec"]["slos"]["calibration"] = {"target": 0.05, "window": "30d"}
+    doc["spec"]["slos"]["feedback_latency"] = {"target": 3600, "unit": "s"}
+    return doc
+
+
+def _load_legacy(tmp_path, doc, caught=None):
+    """Load ``doc`` as a legacy manifest; append any warnings to ``caught``."""
+    path = tmp_path / "fraud-detect.yaml"
+    path.write_text(yaml.safe_dump(doc, sort_keys=False))
+    with warnings.catch_warnings(record=True) as record:
+        warnings.simplefilter("always")
+        manifest = load_manifest(path)
+    if caught is not None:
+        caught.extend(record)
+    return manifest
+
+
+THRESHOLD_NAMES = ("calibration", "feedback_latency")
+
+
+def test_legacy_lifts_calibration_and_feedback_latency_like_srm_v1(tmp_path):
+    legacy = _load_legacy(tmp_path, _legacy_threshold_doc())
+    v1 = parse_srm_v1(_srm_v1_threshold_doc())
+
+    v1_thresholds = {t.type: t for t in v1.get_judgment_thresholds()}
+    assert sorted(v1_thresholds) == sorted(THRESHOLD_NAMES)  # reference sanity
+
+    legacy_thresholds = {t.type: t for t in legacy.get_judgment_thresholds()}
+    assert sorted(legacy_thresholds) == sorted(THRESHOLD_NAMES)
+    for name in THRESHOLD_NAMES:
+        assert legacy_thresholds[name] == v1_thresholds[name]
+    assert legacy_thresholds["calibration"].bounds == {"maximum_expected_calibration_error": 0.05}
+
+
+def test_legacy_threshold_names_not_in_slos(tmp_path):
+    legacy = _load_legacy(tmp_path, _legacy_threshold_doc())
+    names = {s.name for s in legacy.slos}
+    assert names.isdisjoint(THRESHOLD_NAMES)
+    assert names == {"reversal_rate", "high_confidence_failure", "availability"}
+
+
+def test_legacy_threshold_lift_error_is_manifest_load_error(tmp_path):
+    # srm_v1_threshold rejects a unit on calibration (ECE is a ratio); legacy
+    # surfaces that as ManifestLoadError like every other load failure.
+    doc = _legacy_doc()
+    doc["resources"].append(
+        {"kind": "SLO", "name": "calibration", "spec": {"objective": 0.05, "unit": "s"}}
+    )
+    with pytest.raises(ManifestLoadError, match="calibration"):
+        _load_legacy(tmp_path, doc)
+
+
+@pytest.mark.parametrize("name", ["segments", "stability", "audit_backlog"])
+def test_legacy_unliftable_threshold_names_unchanged(tmp_path, name):
+    # srm/v1 rejects these; legacy deliberately does not (breaking in a
+    # patch) and keeps loading them as classical SLOs. Follow-up bead.
+    doc = _legacy_doc()
+    doc["resources"].append({"kind": "SLO", "name": name, "spec": {"objective": 99.0}})
+    legacy = _load_legacy(tmp_path, doc)
+    slo = _by_name(legacy)[name]
+    assert slo.judgment_type is None
+    assert slo.slo_type == "availability"
+    assert legacy.get_judgment_thresholds() == []
+
+
+def _calibration_with_indicator_doc() -> dict:
+    # Legacy SLO resources normally carry spec.indicator
+    # (tests/fixtures/legacy-payment-api.yaml).
+    doc = _legacy_doc()
+    doc["resources"].append({
+        "kind": "SLO",
+        "name": "calibration",
+        "spec": {
+            "objective": 0.05,
+            "window": "30d",
+            "indicator": {"type": "availability", "query": "sum(rate(x[5m]))"},
+        },
+    })
+    return doc
+
+
+def _indicator_warnings(caught):
+    return [
+        w for w in caught
+        if issubclass(w.category, LegacyFormatWarning) and "indicator" in str(w.message)
+    ]
+
+
+def test_legacy_threshold_indicator_dropped_with_warning(tmp_path):
+    # Judgment thresholds don't use the indicator, so the lift drops it and
+    # warns instead of failing a manifest that loads today.
+    caught: list = []
+    legacy = _load_legacy(tmp_path, _calibration_with_indicator_doc(), caught)
+
+    indicator_warnings = _indicator_warnings(caught)
+    assert len(indicator_warnings) == 1
+    assert "calibration" in str(indicator_warnings[0].message)
+
+    expected = {t.type: t for t in parse_srm_v1(_srm_v1_threshold_doc()).get_judgment_thresholds()}
+    assert legacy.get_judgment_thresholds() == [expected["calibration"]]
+    assert "calibration" not in {s.name for s in legacy.slos}
+
+
+def test_legacy_threshold_indicator_warning_points_at_caller(tmp_path):
+    # stacklevel must attribute the warning to load_manifest's caller (here,
+    # _load_legacy in this file), not to a frame inside the loader.
+    caught: list = []
+    _load_legacy(tmp_path, _calibration_with_indicator_doc(), caught)
+    (warning,) = _indicator_warnings(caught)
+    assert Path(warning.filename).resolve() == Path(__file__).resolve()
+
+
+def test_legacy_threshold_unsupported_key_percentile_raises(tmp_path):
+    doc = _legacy_doc()
+    doc["resources"].append({
+        "kind": "SLO",
+        "name": "calibration",
+        "spec": {"objective": 0.05, "percentile": 99, "indicator": {"type": "availability"}},
+    })
+    with pytest.raises(ManifestLoadError, match="percentile"):
+        _load_legacy(tmp_path, doc)
+
+
+# =============================================================================
+# Threshold objective handling (edge cases)
+# =============================================================================
+
+
+def _legacy_with(name: str, spec: dict) -> dict:
+    doc = _legacy_doc()
+    doc["resources"].append({"kind": "SLO", "name": name, "spec": spec})
+    return doc
+
+
+def _v1_threshold(name: str, entry: dict):
+    doc = _srm_v1_doc()
+    doc["spec"]["slos"][name] = entry
+    (threshold,) = parse_srm_v1(doc).get_judgment_thresholds()
+    return threshold
+
+
+def test_legacy_threshold_objective_zero_lifts(tmp_path):
+    # srm/v1 lifts target 0; a falsy objective must not fall through.
+    legacy = _load_legacy(tmp_path, _legacy_with("calibration", {"objective": 0}))
+    (threshold,) = legacy.get_judgment_thresholds()
+    assert threshold.bounds == {"maximum_expected_calibration_error": 0}
+    assert threshold == _v1_threshold("calibration", {"target": 0})
+
+
+@pytest.mark.parametrize("name", THRESHOLD_NAMES)
+def test_legacy_threshold_missing_objective_raises(tmp_path, name):
+    with pytest.raises(ManifestLoadError, match=f"{name}.*requires an objective"):
+        _load_legacy(tmp_path, _legacy_with(name, {"window": "30d"}))
+
+
+@pytest.mark.parametrize("name", THRESHOLD_NAMES)
+def test_legacy_threshold_objective_and_target_both_set_raises(tmp_path, name):
+    with pytest.raises(ManifestLoadError, match=f"{name}.*objective.*target"):
+        _load_legacy(tmp_path, _legacy_with(name, {"objective": 1, "target": 1}))
+
+
+@pytest.mark.parametrize(
+    ("target", "unit", "expected"),
+    [(60, "m", "60m"), (500, "ms", "500ms"), (24, "h", "24h")],
+)
+def test_legacy_feedback_latency_units_match_srm_v1(tmp_path, target, unit, expected):
+    legacy = _load_legacy(
+        tmp_path, _legacy_with("feedback_latency", {"objective": target, "unit": unit})
+    )
+    (threshold,) = legacy.get_judgment_thresholds()
+    assert threshold.bounds == {"maximum_p50": expected}
+    assert threshold == _v1_threshold("feedback_latency", {"target": target, "unit": unit})
+
+
+def test_legacy_feedback_latency_non_30d_window_raises(tmp_path):
+    with pytest.raises(ManifestLoadError, match="feedback_latency.*window"):
+        _load_legacy(
+            tmp_path, _legacy_with("feedback_latency", {"objective": 3600, "window": "7d"})
+        )
+
