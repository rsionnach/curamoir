+              "for": "1m",
+              "labels": {
+                "routing": "self",
+                "service": "mobile-api",
+                "severity": "critical",
+                "team": "mobile",
+                "tier": "critical"
+              }
+            }
+          ]
+        }
+      ]
+    }
+  }
+}
