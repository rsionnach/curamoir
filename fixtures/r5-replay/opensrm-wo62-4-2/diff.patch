+              "for": "2m",
+              "labels": {
+                "routing": "self",
+                "service": "analytics-stream",
+                "severity": "warning",
+                "team": "data",
+                "tier": "high"
+              }
+            }
+          ]
+        },
+        {
+          "name": "analytics-stream-redis",
+          "rules": [
