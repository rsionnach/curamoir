+            "expr": "increase(postgresql_errors_total{type=\"deadlock_detected\"}[1m]) > 1",
+            "for": "1m",
+            "labels": {
+              "routing": "self",
+              "service": "email-worker",
+              "severity": "critical",
+              "team": "notifications",
+              "tier": "standard"
