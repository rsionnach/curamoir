new file mode 100644
index 0000000..f445f42
--- /dev/null
+++ b/tests/golden/data/legacy_recording_rules/services__admin-dashboard-api.json
@@ -0,0 +1,128 @@
+{
+  "groups": [
+    {
+      "interval": "30s",
+      "name": "admin-dashboard-api_slo_metrics",
+      "rules": [
+        {
+          "expr": "sum(increase(http_requests_total{service=\"admin-dashboard-api\"}[30d]))",
+          "labels": {
+            "service": "admin-dashboard-api",
+            "slo": "availability"
+          },
+          "record": "slo:requests_total:30d"
+        },
+        {
+          "expr": "sum(increase(http_requests_total{service=\"admin-dashboard-api\",status!~\"5..\"}[30d]))",
+          "labels": {
+            "service": "admin-dashboard-api",
+            "slo": "availability"
+          },
+          "record": "slo:requests_success:30d"
+        },
+        {
+          "expr": "slo:requests_success:30d{service=\"admin-dashboard-api\",slo=\"availability\"} / slo:requests_total:30d{service=\"admin-dashboard-api\",slo=\"availability\"}",
+          "labels": {
+            "objective": "99.5",
+            "service": "admin-dashboard-api",
+            "slo": "availability"
+          },
+          "record": "slo:availability:ratio"
+        },
+        {
+          "expr": "1 - ((1 - slo:availability:ratio{service=\"admin-dashboard-api\",slo=\"availability\"}) / (1 - 0.995))",
+          "labels": {
+            "objective": "99.5",
+            "service": "admin-dashboard-api",
+            "slo": "availability"
+          },
+          "record": "slo:error_budget_remaining:ratio"
+        },
+        {
+          "expr": "sum(increase(http_request_duration_seconds_count{service=\"admin-dashboard-api\"}[30d]))",
+          "labels": {
+            "service": "admin-dashboard-api",
+            "slo": "latency-p95"
+          },
+          "record": "slo:latency_requests_total:30d"
+        },
+        {
+          "expr": "sum(increase(http_request_duration_seconds_bucket{service=\"admin-dashboard-api\",le=\"0.5\"}[30d]))",
+          "labels": {
+            "service": "admin-dashboard-api",
+            "slo": "latency-p95",
+            "threshold": "500ms"
+          },
+          "record": "slo:latency_requests_fast:30d"
+        },
+        {
+          "expr": "slo:latency_requests_fast:30d{service=\"admin-dashboard-api\",slo=\"latency-p95\"} / slo:latency_requests_total:30d{service=\"admin-dashboard-api\",slo=\"latency-p95\"}",
+          "labels": {
+            "objective": "95.0",
+            "service": "admin-dashboard-api",
+            "slo": "latency-p95"
+          },
+          "record": "slo:latency:ratio"
+        },
+        {
+          "expr": "histogram_quantile(0.5, rate(http_request_duration_seconds_bucket{service=\"admin-dashboard-api\"}[5m]))",
+          "labels": {
+            "service": "admin-dashboard-api",
+            "slo": "latency-p95"
+          },
+          "record": "slo:http_request_duration_seconds:p50"
+        },
+        {
+          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"admin-dashboard-api\"}[5m]))",
+          "labels": {
+            "service": "admin-dashboard-api",
+            "slo": "latency-p95"
+          },
+          "record": "slo:http_request_duration_seconds:p95"
+        },
+        {
+          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"admin-dashboard-api\"}[5m]))",
+          "labels": {
+            "service": "admin-dashboard-api",
+            "slo": "latency-p95"
+          },
+          "record": "slo:http_request_duration_seconds:p99"
+        }
+      ]
+    },
+    {
+      "interval": "30s",
+      "name": "admin-dashboard-api_health_metrics",
+      "rules": [
+        {
+          "expr": "sum(rate(http_requests_total{service=\"admin-dashboard-api\"}[5m]))",
+          "labels": {
+            "service": "admin-dashboard-api"
+          },
+          "record": "service:http_requests:rate5m"
+        },
+        {
+          "expr": "sum(rate(http_requests_total{service=\"admin-dashboard-api\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"admin-dashboard-api\"}[5m]))",
+          "labels": {
+            "service": "admin-dashboard-api"
+          },
+          "record": "service:http_errors:rate5m"
+        },
+        {
+          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"admin-dashboard-api\"}[5m]))",
+          "labels": {
+            "service": "admin-dashboard-api"
+          },
+          "record": "service:http_request_duration_seconds:p95"
+        },
+        {
+          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"admin-dashboard-api\"}[5m]))",
+          "labels": {
+            "service": "admin-dashboard-api"
+          },
+          "record": "service:http_request_duration_seconds:p99"
+        }
+      ]
+    }
+  ]
+}
