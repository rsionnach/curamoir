+            },
+            "expr": "pg_replication_slots_active == 0",
+            "for": "1m",
+            "labels": {
+              "routing": "self",
+              "service": "email-worker",
+              "severity": "warning",
+              "team": "notifications",
+              "tier": "standard"
+            }
